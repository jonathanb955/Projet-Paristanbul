{% extends 'base.html.twig' %}

{% block title %}Magasins{% endblock %}

{% block content %}
    <h1>Paristanbul {{magasin.villeMagasin }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ magasin.id }}</td>
            </tr>
            <tr>
                <th>Ville_magasin</th>
                <td>{{ magasin.villeMagasin }}</td>
            </tr>
            <tr>
                <th>Rue</th>
                <td>{{ magasin.rue }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ magasin.image }}</td>
            </tr>
            <tr>
                <th>Cp</th>
                <td>{{ magasin.cp }}</td>
            </tr>
            <tr>
                <th>Num_tel</th>
                <td>{{ magasin.numTel }}</td>
            </tr>
            <tr>
                <th>Horaire_ouverture</th>
                <td>{{ magasin.horaireOuverture ? magasin.horaireOuverture|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Horaire_fermeture</th>
                <td>{{ magasin.horaireFermeture ? magasin.horaireFermeture|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Jours_ouverture</th>
                <td>{{ magasin.joursOuverture }}</td>
            </tr>
            <tr>
                <th>Video_magasin</th>
                <td>{{ magasin.videoMagasin }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_magasins_index') }}">Retour</a>

    <a href="{{ path('app_magasins_edit', {'id': magasin.id}) }}">modifier</a>

    {{ include('magasins/_delete_form.html.twig') }}
{% endblock %}
