{% extends 'base.html.twig' %}

{% block title %}Modifier Magasins{% endblock %}

{% block content %}
    <h1>Modifier magasin {{ magasin.villeMagasin }}</h1>
    <div class="form-container">
        {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn btn-primary">Enregistrer</button>
        <button class="btn btn-primary" type="reset">Annuler les modifications</button>

        {{ include('magasins/_delete_form.html.twig') }}

        {{ form_end(form) }}
    </div>

    <a href="{{ path('app_magasins_index') }}">Retour vers la liste</a>


{% endblock %}
