{% extends 'base.html.twig' %}

{% block title %}Utilisateur{% endblock %}

{% block content %}
    <h1>Utilisateur</h1>
    <table class="table">
        <tbody>
        <tr>
            <th>Id</th>
            <td>{{ utilisateur.idUtilisateur }}</td>
        </tr>
        <tr>
            <th>Nom</th>
            <td>{{ utilisateur.nom }}</td>
        </tr>
        <tr>
            <th>Prenom</th>
            <td>{{ utilisateur.prenom }}</td>
        </tr>
        <tr>
            <th>Mail</th>
            <td>{{ utilisateur.mail }}</td>
        </tr>
        <tr>
            <th>Mdp</th>
            <td>{{ utilisateur.password }}</td>
        </tr>
        </tbody>
    </table>

    <a href="{{ path('app_utilisateur_index') }}">Retour</a>

    <a href="{{ path('app_utilisateur_edit', {'id': utilisateur.idUtilisateur}) }}">Modifier</a>

    {{ include('utilisateur/_delete_form.html.twig') }}

{% endblock %}
