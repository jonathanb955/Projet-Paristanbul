{% extends 'base.html.twig' %}

{% block title %}Modifier Utilisateur{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/css/form.css') }}">
{% endblock %}

{% block content %}
    <h1>Modifier un Utilisateur</h1>
    <div class="form-container">
        {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn btn-primary">Enregistrer</button>
        <button class="btn btn-primary" type="reset">Annuler les modifications</button>
        {{ include('utilisateur/_delete_form.html.twig') }}
        {{ form_end(form) }}
    </div>

    <a href="{{ path('app_utilisateur_index') }}">Retour à la liste</a>


{% endblock %}
